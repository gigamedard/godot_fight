# ============================================================
# Déploiement CombatGame — L1 Pingala Chain (chainId 99999)
# Copier ce fichier en `.env` (gitignored) puis renseigner.
# NE JAMAIS COMMITTER de clé privée.
# ============================================================

# RPC Pingala (optionnel : une valeur par défaut est utilisée sinon).
PINGALA_RPC_URL=https://31.187.72.98.sslip.io/ext/bc/2bU2988XvYbG4z85k39QxhDNomHWREnTKzYWLViU1RMCeSwEea/rpc

# Clé privée du compte DÉPLOYEUR / owner (fundé en TST natif — pas de faucet public).
PINGALA_DEPLOYER_PK=

# Adresse FRAÎCHE du backendSigner (≠ owner), fundée en TST.
# C'est l'adresse que Laravel utilise pour signer les vouchers et payer le gaz
# des scripts settle/consolidate/withdraw push.
PINGALA_BACKEND_SIGNER_ADDRESS=
