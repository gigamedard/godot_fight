# ============================================================
# Configuration de l'indexeur blockchain (APP2)
# Copier ce fichier en `.env` et adapter les valeurs.
# ============================================================

# --- RPC Pingala Chain (HTTP requis pour le polling getLogs/getBlockNumber) ---
# RPC_HTTP_URL est prioritaire. Sinon RPC_URL est utilisé (ws:// converti en http://).
# L1 Pingala chainId 99999. Plus jamais blockchain:8545.
RPC_HTTP_URL=https://31.187.72.98.sslip.io/ext/bc/2bU2988XvYbG4z85k39QxhDNomHWREnTKzYWLViU1RMCeSwEea/rpc

# --- Contrat ---
# Adresse renseignée après déploiement (blockchain/deployments.pingala.json).
CONTRACT_ADDRESS=0xA2722921B753C1E76e1d9a4294204DF983746C3D
ARTIFACT_PATH=/srv/blockchain/artifacts/contracts/CombatGame.sol/CombatGame.json

# --- Bloc de déploiement (point de départ si aucun état persisté) ---
# Renseigner le bloc RÉEL de déploiement (deployments.pingala.json → blockNumber).
DEPLOYMENT_BLOCK=171

# --- Sécurité reorg (blocs de confirmation avant finalité) ---
# 1-5 en production sur Pingala. 0 réservé au nœud local Hardhat (pas de reorg).
CONFIRMATIONS_REQUIRED=5

# --- Polling ---
POLL_INTERVAL_MS=2000
MAX_BLOCK_RANGE=1000

# --- Backoff exponentiel (erreurs RPC) ---
BACKOFF_BASE_MS=2000
BACKOFF_MAX_MS=30000

# --- Backend Laravel (webhook interne) ---
API_URL=http://api:8000/api/internal
INDEXER_SECRET=super_secret_indexer_token

# --- MySQL (persistance d'état) ---
DB_HOST=db
DB_PORT=3306
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=web3_combat
